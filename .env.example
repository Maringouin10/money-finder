# ---------------------------------------------------------------------------
# Clés d'API
# ---------------------------------------------------------------------------
# Thingiverse : créer une "App" sur https://www.thingiverse.com/apps/create
# puis copier l'App Token ci-dessous (seule plateforme qui exige une clé).
THINGIVERSE_TOKEN=
# Appeler aussi /things/{id}/files pour obtenir la taille des fichiers :
# double le nombre de requêtes et provoque des 429. Laisser à false.
THINGIVERSE_FETCH_FILES=false

# ---------------------------------------------------------------------------
# Recherche
# ---------------------------------------------------------------------------
# Mots-clés séparés par des virgules
KEYWORDS=fidget toy,fidget,infinity cube,planetary gear,print in place fidget
# Plateformes actives : thingiverse,printables,makerworld,crealitycloud
SOURCES=thingiverse,printables,makerworld,crealitycloud
# Nombre de modèles par mot-clé ET par plateforme
LIMIT_PER_KEYWORD=60

# Ne garder que ce qui est exploitable commercialement (true/false)
COMMERCIAL_ONLY=true
# Garder aussi les licences non identifiées quand COMMERCIAL_ONLY=true
INCLUDE_UNKNOWN_LICENSE=true
# Nombre minimum de modèles pour qu'une famille soit créée
MIN_GROUP_SIZE=3

# ---------------------------------------------------------------------------
# Sortie
# ---------------------------------------------------------------------------
OUTPUT_DIR=output
DOWNLOAD_IMAGES=true
# Ouvrir la page détail de chaque modèle (licence + fichiers). Plus lent.
ENRICH_DETAILS=true

# ---------------------------------------------------------------------------
# Réseau
# ---------------------------------------------------------------------------
REQUEST_TIMEOUT=30
# Délai entre deux requêtes. Thingiverse impose au minimum 1,1 s (429 sinon),
# appliqué automatiquement pour cette plateforme.
REQUEST_DELAY=0.8
# Plafond du ralentissement automatique déclenché par les 429/503
MAX_REQUEST_DELAY=8
# Base du backoff exponentiel entre deux tentatives (2 -> 2s, 4s, 8s)
RETRY_BASE=2
MAX_RETRIES=3
DEBUG=false
# USER_AGENT=

# ---------------------------------------------------------------------------
# Endpoints (à modifier seulement si une API change de forme)
# ---------------------------------------------------------------------------
# THINGIVERSE_API=https://api.thingiverse.com
# PRINTABLES_API=https://api.printables.com/graphql/
# PRINTABLES_SEARCH_QUERY=          # requête GraphQL maison (texte ou chemin de fichier)
# MAKERWORLD_API=https://makerworld.com/api/v1
# CREALITYCLOUD_API=https://www.crealitycloud.com
# CREALITYCLOUD_WEB=https://www.crealitycloud.com
# CREALITYCLOUD_SEARCH_PATHS=/api/cxy/smart_search/v1/model

# ---------------------------------------------------------------------------
# Service web (docker compose up web)
# ---------------------------------------------------------------------------
# Port côté hôte
WEB_PORT=8081
# Relancer la collecte automatiquement toutes les N heures (0 = jamais)
REFRESH_HOURS=0
# Utiliser le jeu de démonstration au lieu du vrai scraping (true/false)
DEMO=false
